---
import Badge from "./Badge.astro";

interface Props {
  title: string;
  description: string;
  technologies: string[];
  link?: string;
  github?: string;
}

const { title, description, technologies, link, github } = Astro.props;
---

<div 
  data-spotlight
  class="group relative mb-8 rounded-xl border border-slate-800/80 bg-slate-900/40 p-6 transition-all hover:border-blue-500/30 hover:bg-slate-900/80"
>
  <div class="flex items-center justify-between gap-4">
    <span class="font-mono text-xs font-semibold uppercase tracking-widest text-blue-400">
      // Proyecto Destacado
    </span>
    {link && (
      <a 
        href={link} 
        target="_blank" 
        rel="noopener noreferrer"
        class="font-mono text-xs text-slate-400 transition-colors hover:text-blue-400"
      >
        Ver detalle &rarr;
      </a>
    )}
  </div>

  <h3 class="mt-3 text-lg font-bold text-slate-100 transition-colors group-hover:text-blue-400">
    {title}
  </h3>

  <p class="mt-3 text-sm leading-relaxed text-slate-400">
    {description}
  </p>

  <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tecnologías usadas">
    {technologies.map((tech) => (
      <li>
        <Badge>{tech}</Badge>
      </li>
    ))}
  </ul>
</div>