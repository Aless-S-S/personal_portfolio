<div
    id="certModal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-6 backdrop-blur-sm"
>
    <div
        class="relative w-full max-w-sm rounded-2xl border border-slate-800 bg-slate-900 p-8 shadow-xl"
    >
        <button
            id="modalClose"
            aria-label="Cerrar"
            class="absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full border border-slate-700 text-slate-400 transition-colors hover:border-blue-400 hover:text-blue-400"
        >
            <svg
                class="h-3.5 w-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
            >
                <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
        </button>

        <div class="mb-5 flex items-center gap-4">
            <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg border border-blue-500/20 bg-blue-500/10 text-blue-400"
            >
                <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                >
                    <path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z"
                    ></path>
                    <path d="M9 12l2 2 4-4"></path>
                </svg>
            </div>
            <div>
                <h3
                    id="modalTitle"
                    class="text-[17px] font-bold text-slate-100"
                >
                    —
                </h3>
                <p id="modalIssuer" class="font-mono text-xs text-slate-400">
                    —
                </p>
            </div>
        </div>

        <div class="mb-6 flex flex-col gap-2.5">
            <div
                class="flex justify-between border-b border-slate-800 py-2.5 text-[13.5px]"
            >
                <span class="font-mono text-[11px] text-slate-500">EMITIDA</span
                >
                <span id="modalDate" class="text-slate-400">—</span>
            </div>
        </div>
        <div class="flex gap-3">
            <a
                id="modalLink"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="flex-grow rounded-lg border border-blue-500 bg-blue-500 py-2.5 text-center font-mono text-sm font-semibold text-white transition-opacity hover:opacity-90"
            >
                Ver credencial →
            </a>
            <button
                id="modalCloseBtn"
                class="flex-grow rounded-lg border border-slate-700 py-2.5 font-mono text-sm text-slate-400 transition-colors hover:border-blue-400 hover:text-blue-400"
            >
                Cerrar
            </button>
        </div>
    </div>
</div>

<script>
    const modal = document.getElementById("certModal")!;
    const modalTitle = document.getElementById("modalTitle")!;
    const modalIssuer = document.getElementById("modalIssuer")!;
    const modalDate = document.getElementById("modalDate")!;
    const modalLink = document.getElementById("modalLink") as HTMLAnchorElement;

    let lastFocused: HTMLElement | null = null;

    function openModal(trigger: HTMLElement) {
        lastFocused = trigger;
        modalTitle.textContent = trigger.getAttribute("data-cert-title") ?? "—";
        modalIssuer.textContent =
            trigger.getAttribute("data-cert-issuer") ?? "—";
        modalDate.textContent = trigger.getAttribute("data-cert-date") ?? "—";
        modalLink.href = trigger.getAttribute("data-cert-link") ?? "#";

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.getElementById("modalClose")?.focus();
    }

    function closeModal() {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        lastFocused?.focus();
    }

    document.querySelectorAll("[data-cert-trigger]").forEach((btn) => {
        btn.addEventListener("click", () => openModal(btn as HTMLElement));
    });

    document
        .getElementById("modalClose")
        ?.addEventListener("click", closeModal);
    document
        .getElementById("modalCloseBtn")
        ?.addEventListener("click", closeModal);

    modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal.classList.contains("hidden"))
            closeModal();
    });
</script>
