---
import type { string } from "astro:schema";
import Badge from "./Badge.astro";
import Badge2 from "./Badge2.astro"

interface Props {
  title: string;
  description: string;
  technologies: string[];
  link?: string;
  github?: string;
  badge?: string;
}

const { title, description, technologies, link, github, badge } = Astro.props;
---

<div
  data-spotlight
  class="group relative overflow-hidden rounded-xl border border-slate-800/80 bg-slate-900/40 p-5 transition-all hover:-translate-y-1 hover:border-slate-700"
>
  <div class="mb-3.5 flex items-start justify-between">
    <svg class="h-6 w-6 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M4 6h16M4 12h16M4 18h10"></path>
    </svg>
    <div class="flex items-center gap-3">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" aria-label="Repositorio" class="text-slate-400 transition-colors hover:text-blue-400">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path>
          </svg>
        </a>
      )}
      {link && (
        <a href={link} target="_blank" rel="noopener noreferrer" aria-label="Ver demo" class="text-slate-400 transition-colors hover:text-blue-400">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"></path>
            <path d="M15 3h6v6M10 14L21 3"></path>
          </svg>
        </a>
      )}
      {badge && (        
        <Badge2>{badge}</Badge2>
      )}
    </div>
  </div>

  <h4 class="mb-2 text-[15.5px] font-bold text-slate-100">{title}</h4>
  <p class="mb-3.5 text-[13.5px] leading-relaxed text-slate-400">{description}</p>
  <ul class="flex flex-wrap gap-2" aria-label="Tecnologías usadas">
    {technologies.map((tech) => (
      <li><Badge>{tech}</Badge></li>
    ))}
  </ul>
</div>